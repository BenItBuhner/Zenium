<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the ad-hoc signature applied by build/after-pack.mjs (no Developer ID). The
     same set electron-builder applies to a Developer-ID-signed Electron app: V8's JIT needs the
     first two, and an ad-hoc identity has no Team ID, so library validation must stay off for the
     Electron framework to load. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
