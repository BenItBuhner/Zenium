# Perfetto trace config for the sleeping-tab wake profile (TabWakePerfDemo; W6-S26-b). The
# android-perf-bar-hide.pbtx recipe – the scheduler, HWUI's frames (gfx, view: Choreographer#doFrame,
# traversal, measure, layout, draw on the app's main thread; DrawFrames on its RenderThread),
# input, the window and activity managers, binder, Chromium's slices where the WebView forwards
# them to atrace (webview), every app's own Trace sections (the driver's `zenperf <scene>`
# markers, the host's cheap sections) and SurfaceFlinger's frame timeline – plus `dalvik` for the
# garbage collector's pauses, since a wake decodes a kept picture and builds a WebView. Pushed by
# android-gesture-demo.sh to /data/misc/perfetto-configs/zen-perfetto.pbtx (DEMO_PERFETTO_CONFIG),
# started as a detached session by PerfCapture.kt, pulled as zen-tab-wake.pftrace and read by
# android-perf-trace.py with the driver's scenes.txt.
buffers: {
  size_kb: 131072
  fill_policy: RING_BUFFER
}
buffers: {
  size_kb: 8192
  fill_policy: RING_BUFFER
}
data_sources: {
  config {
    name: "linux.ftrace"
    ftrace_config {
      atrace_categories: "sched"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "input"
      atrace_categories: "wm"
      atrace_categories: "am"
      atrace_categories: "binder_driver"
      atrace_categories: "webview"
      atrace_categories: "dalvik"
      atrace_apps: "*"
      buffer_size_kb: 32768
      drain_period_ms: 250
    }
  }
}
data_sources: {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
      proc_stats_poll_ms: 5000
    }
  }
}
data_sources: {
  config {
    name: "android.surfaceflinger.frametimeline"
  }
}
duration_ms: 900000
write_into_file: true
file_write_period_ms: 2500
max_file_size_bytes: 1000000000
flush_period_ms: 30000
