      "title": "Phone A: API 34 Google APIs, pixel_6",
      "api-level": "34",
      "target": "google_apis",
      "profile": "pixel_6",
      "emulator-gpu": "swangle",
      "emulator-options": "-no-window -no-snapshot -noaudio -no-boot-anim -camera-back none -camera-front none -show-kernel",
      "display": "720x1600@280",
      "timeout-minutes": 90,
      "budget-minutes": 68
    },
