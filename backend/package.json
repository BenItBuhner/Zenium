{
  "name": "zenium-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Zenium accounts and sync: the Convex backend and the accounts website.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p convex && tsc --noEmit -p web && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "web:dev": "vite web",
    "web:build": "vite build web"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.10",
    "@convex-dev/rate-limiter": "^0.4.0",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.60",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
