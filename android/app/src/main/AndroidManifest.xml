<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The chrome's gesture haptics (a tab card picked up in the overview). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- In-app updates: hand a downloaded release APK to the package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!--
          The apps behind the links that leave the web, so the external-protocol sheet can say
          "Open in Gmail?" rather than "another app" (ExternalProtocols.VISIBLE_SCHEMES lists the
          same schemes). Everything else is launched blind and falls back if nothing answers.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mmsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <!--
      Browsing data stays on this device: no cloud backup, and (Android 12+, where allowBackup
      alone does not cover it) no device-to-device transfer either. Nothing here needs restoring:
      settings and profile are small and rebuilt or synced, while WebView cookies, storage,
      downloads metadata, remembered permissions and the agent token must not leave the device.
    -->
    <application
        android:name=".ZenApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/zenium_backup_rules"
        android:dataExtractionRules="@xml/zenium_data_extraction_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zen"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu">

        <!-- Samsung DeX: keep the process (and its tabs) alive when switching displays / density. -->
        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|locale|layoutDirection|fontScale|colorMode">
            <!-- The launcher entry is one of the icon aliases below (Settings → Look and Feel → App
                 icon), which reach this activity through LauncherIconActivity; everything that
                 targets the activity itself keeps working whichever alias is on. Web links arrive
                 through LinkDispatchActivity below, which owns the VIEW http/https filter. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_BROWSER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Zenium's own pages: a `zenium://settings/privacy` deep link (from a notification, a
                 shortcut, another app, `adb shell am start`) opens the page's tab in the browser
                 window – see src/shared/internalPages.ts. The browser's task is the only place it
                 can land. DEFAULT only, no BROWSABLE: a web page must not be able to launch the
                 browser's own pages (Chrome does not register chrome:// either; the desktop takes
                 `zenium://` from argv and open-url but registers no OS handler), and TabWebView
                 refuses a web document's own navigation to them (DeepLinks.refusedFromDocument). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="zenium" />
            </intent-filter>
            <!-- Share target: text and links open or search; an image opens as a page (Share.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- A Chrome extension package (.crx, which Android types as this) opened with or shared
                 to Zenium installs as an extension (ext/ExtensionStore.kt); .zip files come through
                 the picker instead, so Zenium does not offer itself for every archive. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-chrome-extension" />
            </intent-filter>
        </activity>

        <!-- The aliases' target: hands over to MainActivity in its own task and finishes unseen, so
             disabling an alias never removes the browser's task (see LauncherIconActivity). -->
        <activity
            android:name=".LauncherIconActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Where web links arrive (this is what the system offers as a browser and what
             CustomTabsIntent.launchUrl starts). A plain link is forwarded to MainActivity in the
             browser's task; another app's custom tab becomes CustomTabActivity in the caller's own
             task, which this trampoline was started in. Gone before it draws. -->
        <activity
            android:name=".LinkDispatchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Another app's custom tab (CustomTabActivity.kt). Its own, empty affinity keeps it out of
             the singleTask browser's task: it stacks on the caller, as Chrome's does, so closing it
             lands back in the app that opened it. Not exported: everything reaches it through
             LinkDispatchActivity or MainActivity, which have vetted the intent. -->
        <activity
            android:name=".CustomTabActivity"
            android:exported="false"
            android:launchMode="standard"
            android:taskAffinity=""
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Zen.CustomTab"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|locale|layoutDirection|fontScale|colorMode" />

        <!-- The Custom Tabs provider service other apps bind before they open a custom tab
             (CustomTabsConnectionService.kt): warmup, sessions, likely URLs. -->
        <service
            android:name=".CustomTabsConnectionService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.support.customtabs.action.CustomTabsService" />
            </intent-filter>
        </service>

        <!-- app-icon-aliases:begin (Generated by scripts/app-icons.ts from src/shared/appIcon.ts; run `npm run icons` instead of editing.) -->
        <activity-alias
            android:name=".icon.Indigo"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_indigo"
            android:label="@string/app_name"
            android:targetActivity=".LauncherIconActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".icon.Purple"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_purple"
            android:label="@string/app_name"
            android:targetActivity=".LauncherIconActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".icon.Ocean"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ocean"
            android:label="@string/app_name"
            android:targetActivity=".LauncherIconActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".icon.Forest"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_forest"
            android:label="@string/app_name"
            android:targetActivity=".LauncherIconActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".icon.Sunset"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sunset"
            android:label="@string/app_name"
            android:targetActivity=".LauncherIconActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".icon.Rose"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rose"
            android:label="@string/app_name"
            android:targetActivity=".LauncherIconActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".icon.Slate"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_slate"
            android:label="@string/app_name"
            android:targetActivity=".LauncherIconActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".icon.Graphite"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite"
            android:label="@string/app_name"
            android:targetActivity=".LauncherIconActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <!-- app-icon-aliases:end -->

        <!-- The launcher's confirmation that a Home-screen shortcut was pinned (Shortcuts.kt). -->
        <receiver
            android:name=".ShortcutPinnedReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
