<?xml version="1.0" encoding="utf-8"?>
<!-- The search widget's face in the system's dark theme (see values/colors.xml): the v2 tokens'
     dark values, the mark the indigo Theme.Zen lifts for dark. The hint follows the ink on its own
     (res/color/widget_search_hint.xml). On Android 12+ values-night-v31/colors.xml and
     values-night-v34/colors.xml put the system's dark Material You colours over these (WID-03). -->
<resources>
    <color name="widget_search_fill">@color/v2_panel_dark</color>
    <color name="widget_search_hairline">@color/v2_border_dark</color>
    <color name="widget_search_ink">@color/v2_text_dark</color>
    <color name="widget_search_mark">#8284F0</color>

    <!-- The quick actions widget's dark face below Android 12 (see values/colors.xml; WID-02): the v2 tokens' dark values. -->
    <color name="widget_quick_actions_surface">@color/v2_page_dark</color>
    <color name="widget_quick_actions_bar">@color/v2_panel_dark</color>
    <color name="widget_quick_actions_button">@color/v2_panel_dark</color>
    <color name="widget_quick_actions_hairline">@color/v2_border_dark</color>
</resources>
