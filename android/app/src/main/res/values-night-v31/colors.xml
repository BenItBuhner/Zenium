<?xml version="1.0" encoding="utf-8"?>
<!-- The search widget's dark face in Material You's colours on Android 12+ (WID-03; see
     values-v31/colors.xml): MDC 1.12's dark roles (values-v31/tokens.xml:43,58,197,202) – the ink
     onSurfaceVariant = system_neutral2_200, the hairline outlineVariant = system_neutral2_700, the
     hint at the ink's role. The fill lives in res/color-night-v31/widget_search_fill.xml. -->
<resources>
    <color name="widget_search_hairline">@android:color/system_neutral2_700</color>
    <color name="widget_search_ink">@android:color/system_neutral2_200</color>
    <color name="widget_search_hint">@color/widget_search_ink</color>
</resources>
