<?xml version="1.0" encoding="utf-8"?>
<!-- The quick actions widget's bar in the medium form on Android 12+ (WID-02): the system's
     colorSurfaceContainerHigh alone under the ripple, no hairline – as Chrome's
     (quick_action_search_widget_medium_search_bar_background.xml:8-24). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/widget_quick_actions_medium_bar_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_quick_actions_bar" />
            <corners android:radius="@dimen/widget_quick_actions_medium_bar_radius" />
        </shape>
    </item>
</ripple>
