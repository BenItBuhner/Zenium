<?xml version="1.0" encoding="utf-8"?>
<!-- The search widget's dark face in Material You's colours on Android 14+ (WID-03; see
     values-v34/colors.xml): the platform's dark colorOnSurfaceVariant, as MDC 1.12.0 reads it
     (values-v34/tokens.xml:48). The fill lives in res/color-night-v34/widget_search_fill.xml;
     no hairline. -->
<resources>
    <color name="widget_search_ink">@android:color/system_on_surface_variant_dark</color>
    <color name="widget_search_hint">@color/widget_search_ink</color>
</resources>
