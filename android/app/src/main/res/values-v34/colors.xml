<?xml version="1.0" encoding="utf-8"?>
<!-- The search widget's face in Material You's colours on Android 14+ (WID-03; see
     values-v31/colors.xml): the platform publishes the Material 3 roles themselves from API 34,
     and MDC 1.12 reads them there (values-v34/tokens.xml:93,91,101), so the face takes the
     system's own colorSurfaceContainerHigh, colorOnSurfaceVariant and colorOutlineVariant in
     place of the re-lit palette steps of API 31–33. -->
<resources>
    <color name="widget_search_fill">@android:color/system_surface_container_high_light</color>
    <color name="widget_search_hairline">@android:color/system_outline_variant_light</color>
    <color name="widget_search_ink">@android:color/system_on_surface_variant_light</color>
    <color name="widget_search_hint">@color/widget_search_ink</color>
</resources>
