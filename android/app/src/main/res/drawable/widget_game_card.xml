<?xml version="1.0" encoding="utf-8"?>
<!-- The game widget's one-cell card below Android 12 (WID-04): the quick actions widget's surface
     role under its 1 dp hairline (the v2 tokens, in the system's theme; widget_quick_actions_card.xml)
     at the extra-small card's 16 dp radius. On Android 12+ the card is the fill alone at the system's
     widget radius (res/drawable-v31/widget_game_card.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_quick_actions_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_quick_actions_hairline" />
    <corners android:radius="@dimen/widget_game_radius" />
</shape>
