<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher shortcut's icon (res/xml/shortcuts.xml): the mask glyph the chrome's pill shows
     on a private tab, white on the private theme's purple (PRIVATE_THEME in src/shared/theme.ts),
     as an adaptive icon so the launcher masks it like the app's own. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shortcut_private_background" />
    <foreground android:drawable="@drawable/ic_shortcut_private_foreground" />
    <monochrome android:drawable="@drawable/ic_shortcut_private_foreground" />
</adaptive-icon>
