<?xml version="1.0" encoding="utf-8"?>
<!-- The quick actions widget's card below Android 12 (WID-02; the small and medium forms): the page
     fill under a 1 dp hairline (the v2 tokens, in the system's theme), Chrome's 20 dp radius
     (quick_action_search_widget_background.xml:8-12). On Android 12+ the card is the fill alone
     (res/drawable-v31/widget_quick_actions_card.xml) at the system's widget radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_quick_actions_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_quick_actions_hairline" />
    <corners android:radius="@dimen/widget_quick_actions_radius" />
</shape>
