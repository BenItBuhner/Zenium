<?xml version="1.0" encoding="utf-8"?>
<!-- The quick actions widget's extra-small card below Android 12 (WID-02): as widget_quick_actions_card.xml
     at Chrome's 16 dp radius for the 48 dp row (quick_action_search_widget_xsmall_background.xml:8-12). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_quick_actions_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_quick_actions_hairline" />
    <corners android:radius="@dimen/widget_quick_actions_xsmall_radius" />
</shape>
