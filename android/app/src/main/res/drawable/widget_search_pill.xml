<?xml version="1.0" encoding="utf-8"?>
<!-- The search widget's pill: the panel fill under a 1 dp hairline (the v2 tokens, in the system's
     theme), fully rounded at its 48 dp height. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_search_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_search_hairline" />
    <corners android:radius="24dp" />
</shape>
