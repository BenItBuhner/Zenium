<?xml version="1.0" encoding="utf-8"?>
<!-- The Scan QR code shortcut's icon (src/main/shortcuts/shortcuts.xml): the scanner's frame
     (lucide "scan-line"), white on the app icon's indigo, as an adaptive icon so the launcher masks
     it like the app's own. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shortcut_background" />
    <foreground android:drawable="@drawable/ic_shortcut_scan_foreground" />
    <monochrome android:drawable="@drawable/ic_shortcut_scan_foreground" />
</adaptive-icon>
