<?xml version="1.0" encoding="utf-8"?>
<!-- The New tab shortcut's icon (src/main/shortcuts/shortcuts.xml): the bar's new-tab plus (lucide
     "plus"), white on the app icon's indigo, as an adaptive icon so the launcher masks it like the
     app's own. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shortcut_background" />
    <foreground android:drawable="@drawable/ic_shortcut_new_tab_foreground" />
    <monochrome android:drawable="@drawable/ic_shortcut_new_tab_foreground" />
</adaptive-icon>
