<?xml version="1.0" encoding="utf-8"?>
<!-- The Search shortcut's icon (src/main/shortcuts/shortcuts.xml): the omnibox's search glyph
     (lucide "search"), white on the app icon's indigo, as an adaptive icon so the launcher masks it
     like the app's own. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shortcut_background" />
    <foreground android:drawable="@drawable/ic_shortcut_search_foreground" />
    <monochrome android:drawable="@drawable/ic_shortcut_search_foreground" />
</adaptive-icon>
