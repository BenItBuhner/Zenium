<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's hairline round the quick actions widget's preview (res/layout/widget_quick_actions_preview.xml;
     WID-02): Chrome's hairline_border.xml:8-13 – 1 dp of black at 12 % at the card's radius, drawn
     over the preview alone, so the card reads against a picker sheet of the same surface colour. The
     widget as placed wears none of it (res/drawable-v31/widget_quick_actions_card.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="#1F000000" />
    <corners android:radius="@dimen/widget_quick_actions_radius" />
    <padding
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp" />
</shape>
