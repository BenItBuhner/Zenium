<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's hairline round the quick actions widget's preview (res/layout/widget_quick_actions_preview.xml;
     WID-02): 1 dp at the card's radius, drawn over the preview alone, so the card reads against a
     picker sheet of the same surface colour. Chrome frames its preview the same way
     (chrome/browser/ui/android/quickactionsearchwidget/java/res/drawable/hairline_border.xml:8-13) but in
     black_alpha_12, a black literal the design gate (#599) rules out; ours is the v2 border by day and by
     night (widget_quick_actions_hairline: v2_border_light / v2_border_dark, values{,-night}/colors.xml).
     The widget as placed wears none of it (res/drawable-v31/widget_quick_actions_card.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_quick_actions_hairline" />
    <corners android:radius="@dimen/widget_quick_actions_radius" />
    <padding
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp" />
</shape>
