<?xml version="1.0" encoding="utf-8"?>
<!-- The page-unresponsive prompt's arrival: the 120 ms opacity fade the v2 draft allows the native
     sheet in place of the chassis's spring (§9.23; §11.3's reduced-motion form). -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="120"
    android:fromAlpha="0"
    android:interpolator="@android:anim/decelerate_interpolator"
    android:toAlpha="1" />
