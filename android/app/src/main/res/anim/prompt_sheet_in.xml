<?xml version="1.0" encoding="utf-8"?>
<!-- A native prompt sheet comes up on the 120 ms opacity fade of design language v2 §11.3, in
     place: no slide (NativePromptSheet; the duration is PromptSheetSpec.FADE_MS). -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="120"
    android:fromAlpha="0"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:toAlpha="1" />
