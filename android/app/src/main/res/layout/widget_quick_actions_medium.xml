<?xml version="1.0" encoding="utf-8"?>
<!-- The quick actions widget's medium form (QuickActionsWidgetProvider; WID-02), for a face 155 dp
     tall or taller: Chrome's quick_action_search_widget_medium_layout.xml (Chrome 152, :8-90) with
     Zenium's face – a 155 dp card the launcher's cells centre, the omnibox pill (50 dp; the mark,
     the omnibox's own hint at 16 sp) across the top, the mic, the private mask and the scanner as
     54 dp discs in a row under it. The root is @android:id/background under clipToOutline for the
     launcher's clip on Android 12+. The provider hides the buttons the width cannot hold and wires
     every part to its landing (Landing.kt); see widget_quick_actions_xsmall.xml for the colours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_quick_actions_medium_height"
    android:layout_gravity="center"
    android:background="@drawable/widget_quick_actions_card"
    android:clipToOutline="true"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_quick_actions_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_quick_actions_medium_bar_height"
        android:layout_marginHorizontal="@dimen/widget_quick_actions_medium_margin"
        android:layout_marginBottom="@dimen/widget_quick_actions_medium_row_margin"
        android:background="@drawable/widget_quick_actions_medium_bar"
        android:clickable="true"
        android:contentDescription="@string/widget_search_hint"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_quick_actions_mark"
            android:layout_width="@dimen/widget_quick_actions_medium_mark"
            android:layout_height="@dimen/widget_quick_actions_medium_mark"
            android:layout_marginStart="@dimen/widget_quick_actions_medium_mark_margin"
            android:layout_marginEnd="@dimen/widget_quick_actions_medium_mark_margin_text"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_mark" />

        <TextView
            android:id="@+id/widget_quick_actions_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/widget_quick_actions_medium_mark_margin"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/widget_search_hint"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_search_hint"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_quick_actions_row_medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_quick_actions_voice"
            android:layout_width="@dimen/widget_quick_actions_medium_button"
            android:layout_height="@dimen/widget_quick_actions_medium_button"
            android:layout_marginHorizontal="@dimen/widget_quick_actions_medium_button_margin"
            android:background="@drawable/widget_quick_actions_medium_button"
            android:contentDescription="@string/widget_search_mic"
            android:padding="@dimen/widget_quick_actions_medium_button_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_mic" />

        <ImageButton
            android:id="@+id/widget_quick_actions_private"
            android:layout_width="@dimen/widget_quick_actions_medium_button"
            android:layout_height="@dimen/widget_quick_actions_medium_button"
            android:layout_marginHorizontal="@dimen/widget_quick_actions_medium_button_margin"
            android:background="@drawable/widget_quick_actions_medium_button"
            android:contentDescription="@string/widget_search_private"
            android:padding="@dimen/widget_quick_actions_medium_button_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_mask" />

        <ImageButton
            android:id="@+id/widget_quick_actions_scan"
            android:layout_width="@dimen/widget_quick_actions_medium_button"
            android:layout_height="@dimen/widget_quick_actions_medium_button"
            android:layout_marginHorizontal="@dimen/widget_quick_actions_medium_button_margin"
            android:background="@drawable/widget_quick_actions_medium_button"
            android:contentDescription="@string/widget_quick_actions_scan"
            android:padding="@dimen/widget_quick_actions_medium_button_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_scan" />
    </LinearLayout>
</LinearLayout>
