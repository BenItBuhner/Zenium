<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview of the game widget on Android 12+ (previewLayout in
     res/xml/appwidget_game.xml; WID-04): the face at a 64 dp square under the picker's hairline
     (widget_game_preview_frame.xml – the v2 border by day and by night at the card's radius), so the
     card reads against a picker sheet of the same surface colour, as the quick actions widget's
     preview is framed. Older pickers draw the vector under previewImage instead. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/widget_game_preview"
    android:layout_height="@dimen/widget_game_preview"
    android:foreground="@drawable/widget_game_preview_frame"
    tools:ignore="UselessParent">

    <include layout="@layout/widget_game" />
</FrameLayout>
