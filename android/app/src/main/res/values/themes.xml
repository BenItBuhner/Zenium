<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Zen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/zen_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="colorPrimary">#6264DC</item>
        <item name="colorSecondary">#6264DC</item>
    </style>

    <!-- A custom tab: the browser theme, arriving from the bottom and leaving the same way
         (Chrome's default; a caller's own start and exit animations take precedence). -->
    <style name="Theme.Zen.CustomTab">
        <item name="android:windowAnimationStyle">@style/Animation.Zen.CustomTab</item>
    </style>
    <style name="Animation.Zen.CustomTab" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/cct_slide_in_up</item>
        <item name="android:activityOpenExitAnimation">@anim/cct_stay</item>
        <item name="android:activityCloseEnterAnimation">@anim/cct_stay</item>
        <item name="android:activityCloseExitAnimation">@anim/cct_slide_out_down</item>
    </style>

    <!-- A phone sheet drawn natively per the v2 draft (§6): neutral panel, top radius 12, edge to
         edge under the navigation bar, scrim black .4 light / .55 dark. The 1 px border is drawn
         by the sheet's content view (CustomTabMenuSheet, ext/ExtensionSheet). -->
    <style name="ThemeOverlay.Zen.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Zen.Sheet</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="ThemeOverlay.Zen.Sheet.Dark">
        <item name="bottomSheetStyle">@style/Widget.Zen.Sheet.Dark</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>
    <style name="Widget.Zen.Sheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/v2_panel_light</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Zen.Sheet</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>
    <style name="Widget.Zen.Sheet.Dark">
        <item name="backgroundTint">@color/v2_panel_dark</item>
    </style>
    <style name="ShapeAppearance.Zen.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- The custom tab's menu: the same sheet under its own name. -->
    <style name="ThemeOverlay.Zen.CustomTabSheet" parent="ThemeOverlay.Zen.Sheet" />
    <style name="ThemeOverlay.Zen.CustomTabSheet.Dark" parent="ThemeOverlay.Zen.Sheet.Dark" />

    <!-- A native prompt sheet (NativePromptSheet, v2 §9.23): the same sheet, coming and going on
         §11.3's 120 ms opacity fade in place instead of the platform's slide; the dim with it. -->
    <style name="ThemeOverlay.Zen.PromptSheet" parent="ThemeOverlay.Zen.Sheet">
        <item name="android:windowAnimationStyle">@style/Animation.Zen.PromptSheet</item>
    </style>
    <style name="ThemeOverlay.Zen.PromptSheet.Dark" parent="ThemeOverlay.Zen.Sheet.Dark">
        <item name="android:windowAnimationStyle">@style/Animation.Zen.PromptSheet</item>
    </style>
    <style name="Animation.Zen.PromptSheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/prompt_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/prompt_sheet_out</item>
    </style>
</resources>
