<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Zen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/zen_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="colorPrimary">#6264DC</item>
        <item name="colorSecondary">#6264DC</item>
    </style>

    <!-- The cold start's splash (OS-26, MainActivity): the launcher's mark on the brand colour –
         the default icon's background (ic_launcher_colors.xml, generated with the icons) – held
         over the window until the chrome's first real frame (StartupSplash), then the browser
         theme below it. The bars are transparent with light icons over the indigo; the tone the
         chrome asks for meanwhile is applied as the splash lifts. API 33+ draws the icon for a
         plain start too (an `am start` without --splashscreen-show-icon: the harness's and the
         pair tool's), where the default would be the solid colour alone. -->
    <style name="Theme.Zen.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_bg_indigo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Zen</item>
        <item name="android:windowSplashScreenBehavior" tools:targetApi="tiramisu">icon_preferred</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <!-- A custom tab: the browser theme, arriving from the bottom and leaving the same way
         (Chrome's default; a caller's own start and exit animations take precedence). -->
    <style name="Theme.Zen.CustomTab">
        <item name="android:windowAnimationStyle">@style/Animation.Zen.CustomTab</item>
    </style>
    <style name="Animation.Zen.CustomTab" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/cct_slide_in_up</item>
        <item name="android:activityOpenExitAnimation">@anim/cct_stay</item>
        <item name="android:activityCloseEnterAnimation">@anim/cct_stay</item>
        <item name="android:activityCloseExitAnimation">@anim/cct_slide_out_down</item>
    </style>

    <!-- An installed web app's window (WebAppActivity, PWA-07): the browser theme under the
         system's own app-launch animation, as an app of its own. Its own name so the splash
         (PWA-06) has a theme to hang its window attributes on. -->
    <style name="Theme.Zen.WebApp" />

    <!-- A phone sheet drawn natively per the v2 draft (§6): neutral panel, top radius 12, edge to
         edge under the navigation bar, scrim black .4 light / .55 dark. The 1 dp hairline is drawn
         by the sheet's content view (SheetEdge, under NativePromptSheet, ext/ExtensionSheet and
         CustomTabMenuSheet):
         its sides run through the navigation bar to the screen's bottom, so the sheet style pads
         nothing for the bar – the content view takes the bar as its own bottom padding, through the
         edge – where Material's would pad the container and stop the content view, and the
         hairline's sides with it, a bar's height above the panel fill's edge. -->
    <style name="ThemeOverlay.Zen.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Zen.Sheet</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="ThemeOverlay.Zen.Sheet.Dark">
        <item name="bottomSheetStyle">@style/Widget.Zen.Sheet.Dark</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>
    <style name="Widget.Zen.Sheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/v2_panel_light</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Zen.Sheet</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>
    <style name="Widget.Zen.Sheet.Dark">
        <item name="backgroundTint">@color/v2_panel_dark</item>
    </style>
    <style name="ShapeAppearance.Zen.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- The custom tab's menu: the same sheet under its own name. Its content view (CustomTabMenuSheet)
         draws the edge and takes the navigation bar as its own bottom padding through it, like the
         prompt sheet's and the extension sheet's, so the sheet style pads nothing for the bar here
         either: the hairline's sides run through the bar to the screen's bottom. -->
    <style name="ThemeOverlay.Zen.CustomTabSheet" parent="ThemeOverlay.Zen.Sheet" />
    <style name="ThemeOverlay.Zen.CustomTabSheet.Dark" parent="ThemeOverlay.Zen.Sheet.Dark" />

    <!-- A native prompt sheet (NativePromptSheet, v2 §9.23): the same sheet, coming and going on
         §11.3's 120 ms opacity fade in place instead of the platform's slide; the dim with it. -->
    <style name="ThemeOverlay.Zen.PromptSheet" parent="ThemeOverlay.Zen.Sheet">
        <item name="android:windowAnimationStyle">@style/Animation.Zen.PromptSheet</item>
    </style>
    <style name="ThemeOverlay.Zen.PromptSheet.Dark" parent="ThemeOverlay.Zen.Sheet.Dark">
        <item name="android:windowAnimationStyle">@style/Animation.Zen.PromptSheet</item>
    </style>
    <style name="Animation.Zen.PromptSheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/prompt_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/prompt_sheet_out</item>
    </style>

    <!-- The prompt sheet's §9.12 field: the platform draws a field's cursor and selection handles
         in the theme's activated colour (Theme.Zen's primary), so the field is built under this
         overlay, which makes that colour the v2 accent of the theme in force – v2_accent_*, the
         token's value, pinned to main.css – and no ink on the sheet comes from outside the table. -->
    <style name="ThemeOverlay.Zen.PromptField" parent="">
        <item name="android:colorControlActivated">@color/v2_accent_light</item>
        <item name="colorControlActivated">@color/v2_accent_light</item>
    </style>
    <style name="ThemeOverlay.Zen.PromptField.Dark">
        <item name="android:colorControlActivated">@color/v2_accent_dark</item>
        <item name="colorControlActivated">@color/v2_accent_dark</item>
    </style>
</resources>
