<?xml version="1.0" encoding="utf-8"?>
<!-- Nimbus News' bottom toolbar for its custom tab (CustomTabsDemo): the caller's own RemoteViews,
     inflated by the provider into the bar it paints in the secondary toolbar colour. Two text
     buttons the provider reports back by id. Framework views only: RemoteViews allow no others. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <Button
        android:id="@+id/cct_demo_share"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:text="Share story"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/cct_demo_comments"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:text="Comments (42)"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
