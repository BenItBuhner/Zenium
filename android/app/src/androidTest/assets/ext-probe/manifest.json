{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.1.0",
  "description": "Zenium extension-layer probe: measures timing, isolation, messaging, storage and popup stages.",
  "default_locale": "en",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_title": "Probe" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-start.js"],
      "css": ["probe.css"],
      "run_at": "document_start"
    },
    { "matches": ["<all_urls>"], "js": ["content-idle.js"], "run_at": "document_idle" },
    {
      "matches": ["*://*/frame-inner.html*"],
      "js": ["content-frame.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [{ "resources": ["data.json", "page-script.js"], "matches": ["<all_urls>"] }],
  "declarative_net_request": {
    "rule_resources": [{ "id": "probe", "enabled": true, "path": "rules.json" }]
  }
}
