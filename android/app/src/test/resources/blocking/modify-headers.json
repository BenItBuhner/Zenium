          "id": 1,
          "priority": 1,
          "action": {
            "type": "modifyHeaders",
            "requestHeaders": [
              {
                "header": "user-agent",
                "operation": "set",
                "value": "Mozilla/5.0 (Windows NT 10.0; Trident/7.0; rv:11.0) like Gecko"
              }
            ]
          },
          "condition": {}
        }
      ]
    },
